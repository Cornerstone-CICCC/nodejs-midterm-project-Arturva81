    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/node": "^9.4.0",
    "astro": "^5.5.4",
    "bcrypt": "^5.1.1",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/zxcvbn": "^4.4.5",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
