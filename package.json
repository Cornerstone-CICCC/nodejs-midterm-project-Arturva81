{
  "name": "nodejs-midterm-project-arturva81",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "astro dev",
    "dev:server": "tsx watch server/index.ts",
