---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apiBaseUrl } from "../../lib/config";

type MovieItem = {
  id: string;
  title: string;
  description: string;
  watchStatus: "watchlist" | "watched";
  rating: number | null;
  posterPath?: string;
  releaseDate?: string;
};

const q = (Astro.url.searchParams.get("q") ?? "").trim();
const cookieHeader = Astro.request.headers.get("cookie") ?? "";

const meResponse = await fetch(`${apiBaseUrl}/users/me`, {
  headers: {
    cookie: cookieHeader
  }
});

const isLoggedIn = meResponse.ok;

const params = new URLSearchParams();
if (q) params.set("q", q);

const itemsResponse = isLoggedIn
  ? await fetch(`${apiBaseUrl}/items?${params.toString()}`, {
      headers: {
        cookie: cookieHeader
      }
    })
  : null;
const allItems: MovieItem[] = itemsResponse?.ok ? ((await itemsResponse.json()) as MovieItem[]) : [];

const watchlist = allItems.filter((item) => item.watchStatus === "watchlist");
const watched = allItems.filter((item) => item.watchStatus === "watched");
---

<BaseLayout title="Movies">
  <h1>Browse movies</h1>
  {!isLoggedIn && (
    <p>
      Please <a href="/login">log in</a> to view your movies.
    </p>
  )}

  {isLoggedIn && (
    <>
  <form method="get" action="/items">
    <input type="search" name="q" value={q} placeholder="Search movies" />
    <button type="submit">Search</button>
  </form>

  {!allItems.length && <p>No movies found.</p>}

  {!!watchlist.length && (
    <section>
      <h2>Watchlist</h2>
      {watchlist.map((item) => (
        <article>
          <h3>
            <a href={`/items/${item.id}`}>{item.title}</a>
          </h3>
          {item.posterPath && <img src={`https://image.tmdb.org/t/p/w185${item.posterPath}`} alt={item.title} loading="lazy" />}
          {item.releaseDate && <p>{item.releaseDate.slice(0, 4)}</p>}
          <p>
            <a href={`/items/${item.id}`}>View</a> &middot; <a href={`/items/${item.id}/edit`}>Edit</a> &middot; <a href={`/items/${item.id}/edit?markWatched=true`} class="mark-watched">Mark as Watched</a>
          </p>
        </article>
      ))}
    </section>
  )}

  {!!watched.length && (
    <section>
      <h2>Watched</h2>
      {watched.map((item) => (
        <article>
          <h3>
            <a href={`/items/${item.id}`}>{item.title}</a>
          </h3>
          {item.posterPath && <img src={`https://image.tmdb.org/t/p/w185${item.posterPath}`} alt={item.title} loading="lazy" />}
          {item.releaseDate && <p>{item.releaseDate.slice(0, 4)}</p>}
          <p>Rating: {item.rating === null ? "Not rated" : `${item.rating} / 5`}</p>
          {item.description && <p>{item.description}</p>}
          <p>
            <a href={`/items/${item.id}`}>View</a> &middot; <a href={`/items/${item.id}/edit`}>Edit</a>
          </p>
        </article>
      ))}
    </section>
  )}
    </>
  )}
</BaseLayout>
